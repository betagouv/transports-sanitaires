{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Le serveur est exécuté directement par Node : il se résout comme Node, pas
    // comme un bundler.
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "erasableSyntaxOnly": true
  },
  "include": ["server", "shared"]
}
