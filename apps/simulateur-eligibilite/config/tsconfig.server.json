{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Le serveur est exécuté directement par Node : il se résout comme Node, pas
    // comme un bundler.
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["../server", "../shared"]
}
