{
  "name": "simulateur-eligibilite",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev:front": "react-dsfr update-icons",
    "prebuild": "react-dsfr update-icons",
    "dev:front": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "valider-regles": "node scripts/valider-regles.ts",
    "apercu-cerfa": "node scripts/apercu-cerfa.ts",
    "start": "node server/server.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc -b",
    "verifier": "pnpm lint && pnpm typecheck && pnpm knip && pnpm valider-regles && pnpm test && pnpm build",
    "postbuild": "node scripts/verifier-bundle.ts",
    "verifier-bundle": "node scripts/verifier-bundle.ts",
    "knip": "knip --directory ../.. --workspace apps/simulateur-eligibilite"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.32.4",
    "@publicodes/forms": "^0.6.1",
    "express": "^5.1.0",
    "js-yaml": "4.3.1",
    "pdf-lib": "^1.17.1",
    "publicodes": "^1.10.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
