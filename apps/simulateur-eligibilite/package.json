{
  "name": "simulateur-eligibilite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev:front": "react-dsfr update-icons",
    "prebuild": "react-dsfr update-icons",
    "dev:front": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "valider-regles": "node scripts/valider-regles.ts",
    "apercu-cerfa": "node scripts/apercu-cerfa.ts",
    "start": "node server/server.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc -b",
    "verifier": "npm run lint && npm run typecheck && npm run knip && npm run valider-regles && npm test && npm run build",
    "postbuild": "node scripts/verifier-bundle.ts",
    "verifier-bundle": "node scripts/verifier-bundle.ts",
    "knip": "knip"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.32.4",
    "@publicodes/forms": "^0.6.1",
    "express": "^5.1.0",
    "js-yaml": "4.3.1",
    "pdf-lib": "^1.17.1",
    "publicodes": "^1.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.10.4",
    "knip": "^6.32.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
