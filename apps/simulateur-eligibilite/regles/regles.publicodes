cible_cas_final:
  titre: cible_cas_final
  valeur:
    variations:
    - si: p2_transport_charge_etablissement
      alors: '''transport à la charge de l’établissement'''
    - si: p2_permission_charge_patient
      alors: '''permission de sortie sans motif médical'''
    - si: p2_convocation_sans_accord_prealable
      alors: '''convocation ou avis d’audience'''
    - si:
        toutes ces conditions:
        - p2_convocation_orientation_caisse
        - p2_urgence_complete
      alors: '''orientation vers la caisse pour accord préalable'''
    - si: p2_non_eligible_motif_absent
      alors: '''non éligible à une prise en charge par l’Assurance Maladie'''
    - si:
        toutes ces conditions:
        - p2_prescription_donnees_completes
        - p2_document_s3141_determine
      alors: '''prescription S3141'''
    - si:
        toutes ces conditions:
        - p2_prescription_donnees_completes
        - p2_document_dap_determine
      alors: '''demande d’accord préalable'''
    - si:
        toutes ces conditions:
        - p2_prescription_donnees_completes
        - p2_document_pmt_determine
      alors: '''prescription médicale de transport'''
    - sinon: non
  applicable si: p2_entree
cible_resultat_2_affichable:
  titre: cible_resultat_2_affichable
  une de ces conditions:
  - cible_cas_final = 'transport à la charge de l’établissement'
  - cible_cas_final = 'permission de sortie sans motif médical'
  - cible_cas_final = 'convocation ou avis d’audience'
  - cible_cas_final = 'orientation vers la caisse pour accord préalable'
  - cible_cas_final = 'non éligible à une prise en charge par l’Assurance Maladie'
  - cible_cas_final = 'prescription S3141'
  - cible_cas_final = 'demande d’accord préalable'
  - cible_cas_final = 'prescription médicale de transport'
cible_document_a_remettre_au_patient:
  titre: cible_document_a_remettre_au_patient
  valeur:
    variations:
    - si: cible_cas_final = 'prescription médicale de transport'
      alors: '''PMT S3138g'''
    - si: cible_cas_final = 'demande d’accord préalable'
      alors: '''DAP S3139h'''
    - si: cible_cas_final = 'prescription S3141'
      alors: '''S3141'''
    - si: cible_cas_final = 'transport à la charge de l’établissement'
      alors: '''Document interne de l’établissement'''
    - si: cible_cas_final = 'convocation ou avis d’audience'
      alors: '''Convocation ou avis d’audience'''
    - si: cible_cas_final = 'orientation vers la caisse pour accord préalable'
      alors: '''Synthèse pour démarche auprès de la caisse'''
    - sinon: '''aucun document'''
  applicable si: cible_resultat_2_affichable
cible_attente_accord_prealable_requise:
  titre: cible_attente_accord_prealable_requise
  toutes ces conditions:
  - p2_document_dap_determine
  - cible_urgence_attestee = non
cible_regime_financement:
  titre: cible_regime_financement
  valeur:
    variations:
    - si: cible_cas_final = 'transport à la charge de l’établissement'
      alors: '''Établissement'''
    - si: cible_cas_final = 'permission de sortie sans motif médical'
      alors: '''Patient'''
    - si: cible_cas_final = 'convocation ou avis d’audience'
      alors: '''Assurance Maladie'''
    - si: cible_cas_final = 'orientation vers la caisse pour accord préalable'
      alors: '''Assurance Maladie - modalités à confirmer auprès de la caisse'''
    - si: cible_cas_final = 'non éligible à une prise en charge par l’Assurance Maladie'
      alors: '''Absence de prise en charge Assurance Maladie'''
    - si: cible_cas_final = 'prescription S3141'
      alors: '''Assurance Maladie'''
    - si: cible_cas_final = 'demande d’accord préalable'
      alors: '''Assurance Maladie'''
    - si: cible_cas_final = 'prescription médicale de transport'
      alors: '''Assurance Maladie'''
    - sinon: non
  applicable si: cible_resultat_2_affichable
