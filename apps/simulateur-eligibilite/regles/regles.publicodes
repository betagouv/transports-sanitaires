p2_tranche_distance_trajet_aller:
  titre: 'La distance du trajet aller entre les deux adresses renseignées est :'
  question: 'La distance du trajet aller entre les deux adresses renseignées est :'
  applicable si:
    toutes ces conditions:
    - p2_adresses_obligatoires_completes
    - p2_convocation = non
  une possibilité:
  - '''50 km ou moins'''
  - '''Plus de 50 km et jusqu’à 150 km inclus'''
  - '''Plus de 150 km'''
p2_distance_aller_superieure_150km:
  titre: p2_distance_aller_superieure_150km
  valeur:
    variations:
    - si: p2_convocation
      alors: p2_convocation_plus_150km
    - sinon: p2_tranche_distance_trajet_aller = 'Plus de 150 km'
p2_distance_aller_superieure_50km:
  titre: p2_distance_aller_superieure_50km
