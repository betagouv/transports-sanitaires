cible_resultat_medical:
  titre: Décision médicale
  une possibilité:
  - '''décision établie'''
  - '''aucun transport prescriptible'''
  valeur:
    variations:
    - si: p1_decision_medicale_complete
      alors: '''décision établie'''
    - sinon: '''aucun transport prescriptible'''

cible_transport_sanitaire_prescrit:
  titre: Mode de transport retenu par le prescripteur
  description: Valeur calculée par la Partie 1 et figée par l’application lorsque l’utilisateur valide la Page Résultat 1.
  une possibilité:
  - '''aucun'''
  - '''véhicule personnel ou transport en commun'''
  - '''VSL (Véhicule Sanitaire Léger) ou taxi conventionné'''
  - '''VSL (Véhicule Sanitaire Léger) TPMR (Transport de Personnes à Mobilité Réduite) ou taxi conventionné TPMR (Transport de Personnes à Mobilité Réduite)'''
  - '''ambulance'''
  - '''transport par une équipe SMUR (Structure Mobile d’Urgence et de Réanimation)'''
  valeur:
    variations:
    - si: p1_cas_final_direct = 'SMUR'
      alors: '''transport par une équipe SMUR (Structure Mobile d’Urgence et de Réanimation)'''
    - si:
        une de ces conditions:
        - p1_cas_final_direct = 'bariatrique seul'
        - p1_cas_final_direct = 'permission sortie sans motif médical'
      alors: '''aucun'''
    - si: p1_decision_medicale_complete
      alors: p1_mode_transport_medical
    - sinon: '''aucun'''

cible_decision_medicale_verrouillable:
  titre: Décision médicale prête à être verrouillée
  toutes ces conditions:
  - p1_decision_medicale_complete
  - cible_transport_sanitaire_prescrit != 'aucun'

cible_partie_2_requise:
  titre: Partie administrative requise
  une possibilité:
  - '''oui'''
  - '''non'''
  valeur:
    variations:
    - si: p1_cas_final_direct != 'aucun'
      alors: '''non'''
    - si: p1_decision_medicale_complete
      alors: '''oui'''
    - sinon: '''non'''

cible_cas_final:
  titre: Cas final affiché en Page Résultat 2
  description: La cible ne doit être définie qu’après la complétion de toutes les questions obligatoires de la branche active.
  une possibilité:
  - '''prescription médicale de transport'''
  - '''demande d’accord préalable'''
  - '''convocation ou avis d’audience'''
  - '''transport à la charge de l’établissement'''
  - '''prestation non prise en charge par l’Assurance Maladie'''
  - '''SMUR'''
  - '''bariatrique seul'''
  - '''permission de sortie sans motif médical'''
  - '''non éligible à une prise en charge par l’Assurance Maladie'''
  valeur:
    variations:
    - si: p1_cas_final_direct = 'SMUR'
      alors: '''SMUR'''
    - si: p1_cas_final_direct = 'permission sortie sans motif médical'
      alors: '''permission de sortie sans motif médical'''
    - si: p1_cas_final_direct = 'bariatrique seul'
      alors: '''bariatrique seul'''
    - si: p2_transport_charge_etablissement
      alors: '''transport à la charge de l’établissement'''
    - si: p2_prestation_non_prise_en_charge
      alors: '''prestation non prise en charge par l’Assurance Maladie'''
    - si: p2_convocation_ou_avis_valant_prescription
      alors: '''convocation ou avis d’audience'''
    - si:
        toutes ces conditions:
        - p2_document_dap_determine
        - p2_informations_document_completes
      alors: '''demande d’accord préalable'''
    - si:
        toutes ces conditions:
        - p2_document_pmt_determine
        - p2_informations_document_completes
      alors: '''prescription médicale de transport'''
    - si: p2_non_eligible_assurance_maladie
      alors: '''non éligible à une prise en charge par l’Assurance Maladie'''

cible_resultat_2_affichable:
  titre: Page Résultat 2 affichable
  valeur:
    variations:
    - si:
        une de ces conditions:
        - cible_cas_final = 'prescription médicale de transport'
        - cible_cas_final = 'demande d’accord préalable'
        - cible_cas_final = 'convocation ou avis d’audience'
        - cible_cas_final = 'transport à la charge de l’établissement'
        - cible_cas_final = 'prestation non prise en charge par l’Assurance Maladie'
        - cible_cas_final = 'SMUR'
        - cible_cas_final = 'bariatrique seul'
        - cible_cas_final = 'permission de sortie sans motif médical'
        - cible_cas_final = 'non éligible à une prise en charge par l’Assurance Maladie'
      alors: oui
    - sinon: non

cible_document_a_remettre_au_patient:
  titre: Document à remettre au patient
  valeur:
    variations:
    - si: cible_cas_final = 'prescription médicale de transport'
      alors: '''PMT (Prescription Médicale de Transport)'''
    - si: cible_cas_final = 'demande d’accord préalable'
      alors: '''DAP (Demande d’Accord Préalable)'''
    - si: cible_cas_final = 'convocation ou avis d’audience'
      alors: '''convocation ou avis d’audience'''
    - si: cible_cas_final = 'transport à la charge de l’établissement'
      alors: '''formulaire ou document interne de l’établissement'''
    - sinon: '''aucun document'''

cible_regime_financement:
  titre: Régime de financement du transport
  une possibilité:
  - '''Assurance Maladie'''
  - '''établissement prescripteur'''
  - '''patient'''
  - '''urgence spécifique'''
  - '''aucune prise en charge dans ce parcours'''
  valeur:
    variations:
    - si:
        une de ces conditions:
        - cible_cas_final = 'prescription médicale de transport'
        - cible_cas_final = 'demande d’accord préalable'
        - cible_cas_final = 'convocation ou avis d’audience'
      alors: '''Assurance Maladie'''
    - si: cible_cas_final = 'transport à la charge de l’établissement'
      alors: '''établissement prescripteur'''
    - si:
        une de ces conditions:
        - cible_cas_final = 'bariatrique seul'
        - cible_cas_final = 'permission de sortie sans motif médical'
      alors: '''patient'''
    - si: cible_cas_final = 'SMUR'
      alors: '''urgence spécifique'''
    - sinon: '''aucune prise en charge dans ce parcours'''

cible_accompagnant_necessaire:
  titre: Accompagnant nécessaire
  description: Valeur médicale issue de Q1 et destinée notamment au préremplissage de la case correspondante du CERFA.
  valeur: p1_accompagnant_necessaire

cible_transport_partage_applicable:
  titre: Transport partagé applicable
  une de ces conditions:
  - cible_transport_sanitaire_prescrit = 'VSL (Véhicule Sanitaire Léger) ou taxi conventionné'
  - cible_transport_sanitaire_prescrit = 'VSL (Véhicule Sanitaire Léger) TPMR (Transport de Personnes à Mobilité Réduite) ou taxi conventionné TPMR (Transport de Personnes à Mobilité Réduite)'

cible_transport_partage_incompatible:
  titre: Transport partagé incompatible avec l’état de santé
  valeur:
    variations:
    - si: cible_transport_partage_applicable
      alors: p1_transport_partage_incompatible
    - sinon: non

cible_equipement_bariatrique_requis:
  titre: Équipement bariatrique requis
  valeur: p1_m0_bariatrique

cible_ald_reconnue_liee_aux_soins:
  titre: Soins ou examens liés à une ALD (Affection de Longue Durée) reconnue
  valeur: p1_m0_ald

cible_seance_dialyse_radiotherapie_chimiotherapie:
  titre: Séance de dialyse, de radiothérapie ou de chimiothérapie
  valeur: p1_m0_seance

cible_article_80_mode:
  titre: Catégorie du mode pour les contenus relatifs aux transports à la charge de l’établissement
  une possibilité:
  - '''non applicable'''
  - '''transport professionnel'''
  - '''véhicule personnel ou transport en commun'''
  valeur:
    variations:
    - si: cible_cas_final != 'transport à la charge de l’établissement'
      alors: '''non applicable'''
    - si: cible_transport_sanitaire_prescrit = 'véhicule personnel ou transport en commun'
      alors: '''véhicule personnel ou transport en commun'''
    - sinon: '''transport professionnel'''

cible_article_80_situation_specifique:
  titre: Situation spécifique d’un patient détenu
  valeur: p2_article_80_situation_specifique

cible_prise_en_charge_prestation:
  titre: Prise en charge de la prestation à l’origine du déplacement
  une possibilité:
  - '''oui'''
  - '''non'''
  - '''non applicable'''
  valeur:
    variations:
    - si: p2_prestation_prise_en_charge_applicable = non
      alors: '''non applicable'''
    - si: p2_prestation_prise_en_charge_assurance_maladie
      alors: '''oui'''
    - si: p2_prestation_prise_en_charge_assurance_maladie = non
      alors: '''non'''

cible_lieu_depart_type:
  titre: Type du lieu de départ
  valeur: p2_trajet_depart

cible_lieu_arrivee_type:
  titre: Type du lieu d’arrivée
  valeur: p2_trajet_arrivee

cible_document_depart_nom:
  titre: Nom du lieu de départ
  valeur: p2_depart_nom_lieu

cible_document_depart_adresse:
  titre: Adresse du lieu de départ
  valeur: p2_depart_adresse

cible_document_depart_complement:
  titre: Complément d’adresse du lieu de départ
  valeur: p2_depart_complement_adresse

cible_document_depart_code_postal:
  titre: Code postal du lieu de départ
  valeur: p2_depart_code_postal

cible_document_depart_commune:
  titre: Commune du lieu de départ
  valeur: p2_depart_commune

cible_document_depart_pays:
  titre: Pays du lieu de départ
  valeur: p2_depart_pays

cible_document_arrivee_nom:
  titre: Nom du lieu d’arrivée
  valeur: p2_arrivee_nom_lieu

cible_document_arrivee_adresse:
  titre: Adresse du lieu d’arrivée
  valeur: p2_arrivee_adresse

cible_document_arrivee_complement:
  titre: Complément d’adresse du lieu d’arrivée
  valeur: p2_arrivee_complement_adresse

cible_document_arrivee_code_postal:
  titre: Code postal du lieu d’arrivée
  valeur: p2_arrivee_code_postal

cible_document_arrivee_commune:
  titre: Commune du lieu d’arrivée
  valeur: p2_arrivee_commune

cible_document_arrivee_pays:
  titre: Pays du lieu d’arrivée
  valeur: p2_arrivee_pays

# PARTIE 1 - Évaluation médicale

p1_autonomie:
  titre: Autonomie et besoins généraux
  question: 'Le patient :'
  une possibilité:
  - '''Peut se déplacer seul, sans aide technique ou humaine et sans besoin particulier sur l’entièreté du trajet.'''
  - '''Peut se déplacer avec un proche accompagnant, qui peut l’aider à se déplacer ou à transmettre les informations nécessaires à l’équipe soignante, sans intervention d’un professionnel pendant le transport.'''
  - '''Nécessite une prise en charge spécifique pendant le trajet ou l’aide d’un professionnel pour se déplacer ou accomplir les formalités liées au transport.'''
  spec_id: Q1

p1_autonomie_repondue:
  titre: Réponse à la question sur l’autonomie renseignée
  une de ces conditions:
  - p1_autonomie = 'Peut se déplacer seul, sans aide technique ou humaine et sans besoin particulier sur l’entièreté du trajet.'
  - p1_autonomie = 'Peut se déplacer avec un proche accompagnant, qui peut l’aider à se déplacer ou à transmettre les informations nécessaires à l’équipe soignante, sans intervention d’un professionnel pendant le transport.'
  - p1_autonomie = 'Nécessite une prise en charge spécifique pendant le trajet ou l’aide d’un professionnel pour se déplacer ou accomplir les formalités liées au transport.'

p1_accompagnant_necessaire:
  titre: Accompagnant nécessaire
  valeur:
    variations:
    - si: p1_autonomie = 'Peut se déplacer avec un proche accompagnant, qui peut l’aider à se déplacer ou à transmettre les informations nécessaires à l’équipe soignante, sans intervention d’un professionnel pendant le transport.'
      alors: oui
    - si: p1_autonomie_repondue
      alors: non

p1_autonomie_professionnel_requis:
  titre: Intervention d’un professionnel requise
  valeur: p1_autonomie = 'Nécessite une prise en charge spécifique pendant le trajet ou l’aide d’un professionnel pour se déplacer ou accomplir les formalités liées au transport.'

p1_critere_incapacite_deplacement_autonome:
  question: Ne peut pas se déplacer de manière autonome sur une longue distance, utiliser seul les transports en commun ou conduire un véhicule personnel en raison de sa pathologie, de son traitement ou d’un handicap.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_aide_technique:
  question: Nécessite une aide technique, telle qu’un fauteuil roulant, un déambulateur ou des béquilles, et une assistance pour monter dans le véhicule ou en descendre.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_aide_professionnel:
  question: Nécessite l’aide d’un professionnel pendant le trajet ou pour accomplir les formalités liées au transport, en l’absence d’un proche accompagnant.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_hygiene_desinfection:
  question: Nécessite le respect rigoureux de règles d’hygiène ou la désinfection du véhicule afin de prévenir un risque infectieux.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_risque_effets_secondaires:
  question: Présente un risque d’effets secondaires, de malaise ou de complications pendant le transport.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_fauteuil_sans_transfert:
  question: Doit rester dans son fauteuil roulant manuel ou électrique pendant le transport.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_position_allongee_demi_assise:
  question: Doit être transporté en position allongée ou semi-allongée, car son état ne permet pas la position assise.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_brancardage_portage:
  question: Nécessite un brancardage ou un portage, y compris pour se déplacer sur une courte distance.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_surveillance_constante:
  question: Nécessite une surveillance constante par une personne qualifiée et la présence de matériel de secours en raison d’un risque de dégradation de son état.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_oxygene:
  question: Nécessite l’administration d’oxygène pendant le transport.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_isolement_asepsie:
  question: Nécessite un transport dans des conditions d’isolement, d’asepsie ou de désinfection strictes en raison d’un risque infectieux.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_critere_aucune_situation:
  question: Aucune de ces situations ne s’applique au patient.
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_criteres_transport:
  titre: Aides et conditions particulières
  question: Quelles aides ou conditions particulières sont nécessaires pendant le transport ?
  description: Sélectionnez toutes les réponses correspondant à la situation du patient.
  mosaique:
    type: selection
    options:
    - p1_critere_incapacite_deplacement_autonome
    - p1_critere_aide_technique
    - p1_critere_aide_professionnel
    - p1_critere_hygiene_desinfection
    - p1_critere_risque_effets_secondaires
    - p1_critere_fauteuil_sans_transfert
    - p1_critere_position_allongee_demi_assise
    - p1_critere_brancardage_portage
    - p1_critere_surveillance_constante
    - p1_critere_oxygene
    - p1_critere_isolement_asepsie
    option aucun: p1_critere_aucune_situation
  applicable si: p1_autonomie_professionnel_requis
  spec_id: Q1.1

p1_criteres_transport_repondus:
  titre: Réponse aux aides et conditions particulières renseignée
  une de ces conditions:
  - p1_critere_incapacite_deplacement_autonome
  - p1_critere_aide_technique
  - p1_critere_aide_professionnel
  - p1_critere_hygiene_desinfection
  - p1_critere_risque_effets_secondaires
  - p1_critere_fauteuil_sans_transfert
  - p1_critere_position_allongee_demi_assise
  - p1_critere_brancardage_portage
  - p1_critere_surveillance_constante
  - p1_critere_oxygene
  - p1_critere_isolement_asepsie
  - p1_critere_aucune_situation

p1_critere_ambulance:
  titre: Au moins un critère justifie une ambulance
  une de ces conditions:
  - p1_critere_position_allongee_demi_assise
  - p1_critere_brancardage_portage
  - p1_critere_surveillance_constante
  - p1_critere_oxygene
  - p1_critere_isolement_asepsie

p1_mode_transport_medical:
  titre: Mode de transport médicalement adapté avant les cas particuliers
  une possibilité:
  - '''véhicule personnel ou transport en commun'''
  - '''VSL (Véhicule Sanitaire Léger) ou taxi conventionné'''
  - '''VSL (Véhicule Sanitaire Léger) TPMR (Transport de Personnes à Mobilité Réduite) ou taxi conventionné TPMR (Transport de Personnes à Mobilité Réduite)'''
  - '''ambulance'''
  valeur:
    variations:
    - si: p1_critere_ambulance
      alors: '''ambulance'''
    - si: p1_critere_fauteuil_sans_transfert
      alors: '''VSL (Véhicule Sanitaire Léger) TPMR (Transport de Personnes à Mobilité Réduite) ou taxi conventionné TPMR (Transport de Personnes à Mobilité Réduite)'''
    - si: p1_autonomie_professionnel_requis
      alors: '''VSL (Véhicule Sanitaire Léger) ou taxi conventionné'''
    - si: p1_autonomie_repondue
      alors: '''véhicule personnel ou transport en commun'''

p1_transport_partage_etape_applicable:
  titre: Question sur le transport partagé applicable
  toutes ces conditions:
  - p1_criteres_et_autonomie_complets
  - une de ces conditions:
    - p1_mode_transport_medical = 'VSL (Véhicule Sanitaire Léger) ou taxi conventionné'
    - p1_mode_transport_medical = 'VSL (Véhicule Sanitaire Léger) TPMR (Transport de Personnes à Mobilité Réduite) ou taxi conventionné TPMR (Transport de Personnes à Mobilité Réduite)'

p1_transport_partage_incompatible:
  titre: Incompatibilité avec un transport partagé
  question: L’état de santé du patient est-il incompatible avec un transport partagé ?
  applicable si: p1_transport_partage_etape_applicable
  spec_id: M4

p1_transport_partage_repondu:
  titre: Réponse sur le transport partagé renseignée
  une de ces conditions:
  - p1_transport_partage_incompatible
  - p1_transport_partage_incompatible = non

p1_criteres_et_autonomie_complets:
  titre: Évaluation de l’autonomie et des besoins complète
  valeur:
    variations:
    - si: p1_autonomie_professionnel_requis
      alors: p1_criteres_transport_repondus
    - si: p1_autonomie_repondue
      alors: oui
    - sinon: non

p1_m0_smur:
  question: Le patient doit être transporté par une équipe SMUR (Structure Mobile d’Urgence et de Réanimation).
  applicable si: p1_criteres_et_autonomie_complets
  spec_id: M0

p1_m0_bariatrique:
  question: La morphologie ou le poids du patient (plus de 150 kg) nécessite un véhicule disposant d’un équipement bariatrique adapté.
  applicable si: p1_criteres_et_autonomie_complets
  spec_id: M0

p1_m0_permission_sans_motif_medical:
  question: Le déplacement correspond à une permission de sortie demandée par le patient, sans motif médical.
  applicable si: p1_criteres_et_autonomie_complets
  spec_id: M0

p1_m0_ald:
  question: Soins ou examens en lien avec une ALD (Affection de Longue Durée) reconnue pour ce patient par l’Assurance Maladie, exonérante ou non exonérante.
  applicable si: p1_criteres_et_autonomie_complets
  spec_id: M0

p1_m0_seance:
  question: Séance de dialyse, y compris d’hémodialyse, de radiothérapie ou de chimiothérapie.
  applicable si: p1_criteres_et_autonomie_complets
  spec_id: M0

p1_m0_aucun:
  question: Aucun de ces cas médicaux.
  applicable si: p1_criteres_et_autonomie_complets
  spec_id: M0

p1_cas_particuliers_medicaux:
  titre: Cas particuliers médicaux
  question: Avant d’établir le mode de transport adéquat, sélectionnez tous les éventuels cas particuliers concernant le patient.
  description: Sélectionnez tous les cas concernés.
  mosaique:
    type: selection
    options:
    - p1_m0_smur
    - p1_m0_bariatrique
    - p1_m0_permission_sans_motif_medical
    - p1_m0_ald
    - p1_m0_seance
    option aucun: p1_m0_aucun
  applicable si: p1_criteres_et_autonomie_complets
  spec_id: M0

p1_cas_particuliers_repondus:
  titre: Réponse aux cas particuliers médicaux renseignée
  une de ces conditions:
  - p1_m0_smur
  - p1_m0_bariatrique
  - p1_m0_permission_sans_motif_medical
  - p1_m0_ald
  - p1_m0_seance
  - p1_m0_aucun

p1_bariatrique_seul:
  titre: Contrainte bariatrique sans autre besoin médical identifié
  toutes ces conditions:
  - p1_m0_bariatrique
  - p1_autonomie_professionnel_requis = non
  - p1_m0_ald = non
  - p1_m0_seance = non
  - p1_critere_ambulance = non

p1_ald_incapacite_ou_deficience:
  titre: Incapacité ou déficience associée à une ALD (Affection de Longue Durée)
  valeur:
    variations:
    - si: p1_autonomie_professionnel_requis
      alors: oui
    - si: p1_autonomie = 'Peut se déplacer avec un proche accompagnant, qui peut l’aider à se déplacer ou à transmettre les informations nécessaires à l’équipe soignante, sans intervention d’un professionnel pendant le transport.'
      alors: oui
    - sinon: non

p1_ald_validee:
  titre: Situation ALD (Affection de Longue Durée) médicalement qualifiée
  toutes ces conditions:
  - p1_m0_ald
  - une de ces conditions:
    - p1_ald_incapacite_ou_deficience
    - p1_m0_seance

p1_cas_final_direct:
  titre: Cas final déterminé dès la Partie 1
  une possibilité:
  - '''aucun'''
  - '''SMUR'''
  - '''bariatrique seul'''
  - '''permission sortie sans motif médical'''
  valeur:
    variations:
    - si: p1_m0_smur
      alors: '''SMUR'''
    - si: p1_m0_permission_sans_motif_medical
      alors: '''permission sortie sans motif médical'''
    - si: p1_bariatrique_seul
      alors: '''bariatrique seul'''
    - sinon: '''aucun'''

p1_decision_medicale_complete:
  titre: Partie médicale complète
  toutes ces conditions:
  - p1_criteres_et_autonomie_complets
  - p1_cas_particuliers_repondus
  - une de ces conditions:
    - p1_transport_partage_etape_applicable = non
    - p1_transport_partage_repondu

# PARTIE 2 - Qualification administrative

p2_contexte_hospitalisation:
  question: Entrée ou sortie d’hospitalisation complète, partielle ou ambulatoire.
  applicable si: cible_partie_2_requise = 'oui'
  spec_id: M1.1

p2_contexte_at_mp:
  question: Soins en rapport avec un AT (Accident du Travail) ou une MP (Maladie Professionnelle).
  applicable si: cible_partie_2_requise = 'oui'
  spec_id: M1.1

p2_contexte_retour_penitentiaire:
  question: Retour vers un établissement pénitentiaire sur prescription médicale.
  applicable si: cible_partie_2_requise = 'oui'
  spec_id: M1.1

p2_contexte_aucun:
  question: Aucun de ces contextes ne correspond à la situation du patient.
  applicable si: cible_partie_2_requise = 'oui'
  spec_id: M1.1

p2_contexte_administratif:
  titre: Contexte administratif
  question: Dans quel contexte le déplacement est-il réalisé ?
  description: Plusieurs choix sont possibles. Sélectionnez toutes les réponses correspondant à la situation du patient.
  mosaique:
    type: selection
    options:
    - p2_contexte_hospitalisation
    - p2_contexte_at_mp
    - p2_contexte_retour_penitentiaire
    option aucun: p2_contexte_aucun
  applicable si: cible_partie_2_requise = 'oui'
  spec_id: M1.1

p2_contexte_administratif_repondu:
  titre: Contexte administratif renseigné
  une de ces conditions:
  - p2_contexte_hospitalisation
  - p2_contexte_at_mp
  - p2_contexte_retour_penitentiaire
  - p2_contexte_aucun

p2_patient_hospitalise:
  titre: Patient hospitalisé au moment du transport
  question: Au moment exact du transport, le patient sera-t-il toujours hospitalisé, notamment dans le cadre d’un transfert vers un autre établissement ou d’un déplacement temporaire pour recevoir des soins ?
  description: Répondez « Non » si le patient quitte les urgences ou une consultation sans avoir été hospitalisé dans l’établissement de départ.
  applicable si:
    toutes ces conditions:
    - cible_partie_2_requise = 'oui'
    - p2_contexte_administratif_repondu
  spec_id: A0.1

p2_patient_hospitalise_repondu:
  titre: Statut d’hospitalisation renseigné
  une de ces conditions:
  - p2_patient_hospitalise
  - p2_patient_hospitalise = non

p2_exception_aide_medicale_urgente:
  question: Transport sanitaire réalisé dans le cadre de l’aide médicale urgente, hors équipe SMUR (Structure Mobile d’Urgence et de Réanimation).
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_avion_bateau:
  question: Transport par avion ou par bateau.
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_had_hors_protocole:
  question: Transport prescrit par un établissement d’HAD (Hospitalisation À Domicile) en dehors d’un transfert de moins de 48 heures prévu par le protocole de soins ou lié à la prise en charge en cours.
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_usld:
  question: Transport depuis ou vers une USLD (Unité de Soins de Longue Durée), hors établissements situés sur la même implantation géographique.
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_ehpad:
  question: Transport depuis ou vers un EHPAD (Établissement d’Hébergement pour Personnes Âgées Dépendantes), hors établissements situés sur la même implantation géographique.
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_radiotherapie_moins_48h:
  question: Transfert de moins de 48 heures pour une séance de radiothérapie dans une structure d’exercice libéral ou un centre de santé.
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_dialyse_domicile:
  question: Transport d’un patient pratiquant la dialyse à domicile.
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_admission_had:
  question: Transport d’un patient hospitalisé vers son domicile dans le cadre d’une admission en HAD (Hospitalisation À Domicile).
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_permission_mineur:
  question: Permission de sortie de moins de 48 heures pour un patient de moins de 20 ans hospitalisé depuis plus de 14 jours.
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exception_aucune:
  question: Aucune de ces exceptions ne s’applique au transport.
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exceptions_assurance_maladie:
  titre: Exceptions restant prises en charge dans les conditions de l’Assurance Maladie
  question: Le transport relève-t-il d’une ou plusieurs de ces exceptions restant prises en charge dans les conditions de l’Assurance Maladie ?
  description: Sélectionnez toutes les réponses correspondant à la situation du patient.
  mosaique:
    type: selection
    options:
    - p2_exception_aide_medicale_urgente
    - p2_exception_avion_bateau
    - p2_exception_had_hors_protocole
    - p2_exception_usld
    - p2_exception_ehpad
    - p2_exception_radiotherapie_moins_48h
    - p2_exception_dialyse_domicile
    - p2_exception_admission_had
    - p2_exception_permission_mineur
    option aucun: p2_exception_aucune
  applicable si: p2_patient_hospitalise
  spec_id: A0.2

p2_exceptions_repondues:
  titre: Réponse aux exceptions renseignée
  une de ces conditions:
  - p2_exception_aide_medicale_urgente
  - p2_exception_avion_bateau
  - p2_exception_had_hors_protocole
  - p2_exception_usld
  - p2_exception_ehpad
  - p2_exception_radiotherapie_moins_48h
  - p2_exception_dialyse_domicile
  - p2_exception_admission_had
  - p2_exception_permission_mineur
  - p2_exception_aucune

p2_exception_restant_assurance_maladie:
  titre: Au moins une exception relevant de l’Assurance Maladie
  une de ces conditions:
  - p2_exception_aide_medicale_urgente
  - p2_exception_avion_bateau
  - p2_exception_had_hors_protocole
  - p2_exception_usld
  - p2_exception_ehpad
  - p2_exception_radiotherapie_moins_48h
  - p2_exception_dialyse_domicile
  - p2_exception_admission_had
  - p2_exception_permission_mineur

p2_detenu_hospitalise:
  titre: Patient détenu hospitalisé
  question: Le patient hospitalisé est-il détenu ?
  applicable si:
    toutes ces conditions:
    - p2_patient_hospitalise
    - p2_exceptions_repondues
    - p2_contexte_retour_penitentiaire = non
  spec_id: A1.1

p2_detenu_inter_etablissements:
  titre: Transport inter-établissements d’un patient détenu
  question: Le transport du patient détenu est-il un transport inter-établissements ?
  applicable si: p2_detenu_hospitalise
  spec_id: A1.2

p2_detenu_uhsa_uhsi:
  titre: Aller sans consentement d’un patient détenu
  question: Le transport du patient détenu concerne-t-il un aller sans consentement vers une UHSA (Unité Hospitalière Spécialement Aménagée) ou une UHSI (Unité Hospitalière Sécurisée Interrégionale) ?
  applicable si:
    toutes ces conditions:
    - p2_detenu_hospitalise
    - p2_detenu_inter_etablissements = non
  spec_id: A1.3

p2_transport_charge_etablissement:
  titre: Transport à la charge de l’établissement
  une de ces conditions:
  - toutes ces conditions:
    - p2_patient_hospitalise
    - p2_exceptions_repondues
    - p2_exception_restant_assurance_maladie = non
    - p2_contexte_retour_penitentiaire = non
    - p2_detenu_hospitalise = non
  - p2_detenu_inter_etablissements
  - p2_detenu_uhsa_uhsi

p2_article_80_situation_specifique:
  titre: Transport à la charge de l’établissement pour un patient détenu
  une de ces conditions:
  - p2_detenu_inter_etablissements
  - p2_detenu_uhsa_uhsi

p2_detenu_hors_parcours_standard:
  titre: Situation d’un patient détenu ne relevant pas du parcours standard
  toutes ces conditions:
  - p2_detenu_hospitalise
  - p2_detenu_inter_etablissements = non
  - p2_detenu_uhsa_uhsi = non
  - p2_contexte_retour_penitentiaire = non

p2_parcours_standard_applicable:
  titre: Parcours standard de l’Assurance Maladie applicable
  une de ces conditions:
  - p2_patient_hospitalise = non
  - p2_contexte_retour_penitentiaire
  - toutes ces conditions:
    - p2_patient_hospitalise
    - p2_exceptions_repondues
    - p2_exception_restant_assurance_maladie
    - p2_detenu_hospitalise = non

p2_convocation_ou_avis:
  titre: Convocation ou avis d’audience
  question: Le transport est-il lié à une convocation ou à un avis d’audience valant prescription médicale de transport ?
  applicable si: p2_parcours_standard_applicable
  spec_id: A2.1

p2_convocation_ou_avis_type:
  titre: Type de convocation ou d’avis
  question: Quel type de convocation ou d’avis est concerné ?
  une possibilité:
  - '''Convocation du contrôle médical.'''
  - '''Convocation d’un médecin-expert ou consultant désigné par une juridiction.'''
  - '''Audience au cours de laquelle une consultation clinique a lieu.'''
  - '''Consultation d’un expert désigné selon l’article R. 141-1 du Code de la sécurité sociale.'''
  - '''Convocation de la commission prévue par l’article R. 142-8 du Code de la sécurité sociale.'''
  - '''Convocation du médecin désigné par cette commission.'''
  - '''Déplacement chez un fournisseur d’appareillage agréé.'''
  applicable si: p2_convocation_ou_avis
  spec_id: A2.2

p2_convocation_ou_avis_type_repondu:
  titre: Type de convocation ou d’avis renseigné
  une de ces conditions:
  - p2_convocation_ou_avis_type = 'Convocation du contrôle médical.'
  - p2_convocation_ou_avis_type = 'Convocation d’un médecin-expert ou consultant désigné par une juridiction.'
  - p2_convocation_ou_avis_type = 'Audience au cours de laquelle une consultation clinique a lieu.'
  - p2_convocation_ou_avis_type = 'Consultation d’un expert désigné selon l’article R. 141-1 du Code de la sécurité sociale.'
  - p2_convocation_ou_avis_type = 'Convocation de la commission prévue par l’article R. 142-8 du Code de la sécurité sociale.'
  - p2_convocation_ou_avis_type = 'Convocation du médecin désigné par cette commission.'
  - p2_convocation_ou_avis_type = 'Déplacement chez un fournisseur d’appareillage agréé.'

p2_convocation_ou_avis_valant_prescription:
  titre: Convocation ou avis valant prescription
  toutes ces conditions:
  - p2_convocation_ou_avis
  - p2_convocation_ou_avis_type_repondu

p2_parcours_apres_convocation:
  titre: Parcours poursuivi après la question sur les convocations
  toutes ces conditions:
  - p2_parcours_standard_applicable
  - p2_convocation_ou_avis = non

p2_prestation_question_non_requise:
  titre: Question sur la prestation non requise
  toutes ces conditions:
  - p2_parcours_apres_convocation
  - une de ces conditions:
    - p2_contexte_hospitalisation
    - p2_contexte_at_mp
    - p2_contexte_retour_penitentiaire
    - p1_m0_seance
    - p2_exception_restant_assurance_maladie

p2_prestation_prise_en_charge_applicable:
  titre: Question sur la prise en charge de la prestation applicable
  toutes ces conditions:
  - p2_parcours_apres_convocation
  - p2_prestation_question_non_requise = non

p2_prestation_prise_en_charge_assurance_maladie:
  titre: Prise en charge de la prestation à l’origine du déplacement
  question: La consultation, le soin, l’examen ou la prestation à l’origine du déplacement est-il pris en charge par l’Assurance Maladie ?
  applicable si: p2_prestation_prise_en_charge_applicable
  spec_id: A2.3

p2_prestation_prise_en_charge_repondue:
  titre: Réponse sur la prise en charge de la prestation renseignée
  une de ces conditions:
  - p2_prestation_prise_en_charge_assurance_maladie
  - p2_prestation_prise_en_charge_assurance_maladie = non

p2_prestation_non_prise_en_charge:
  titre: Prestation non prise en charge
  toutes ces conditions:
  - p2_prestation_prise_en_charge_applicable
  - p2_prestation_prise_en_charge_assurance_maladie = non

p2_prestation_prise_en_charge_validee:
  titre: Prise en charge de la prestation validée
  une de ces conditions:
  - p2_prestation_question_non_requise
  - p2_prestation_prise_en_charge_assurance_maladie

p2_motif_ouvrant_droit:
  titre: Motif ouvrant droit à une prise en charge du transport
  une de ces conditions:
  - p2_contexte_hospitalisation
  - p2_contexte_at_mp
  - p2_contexte_retour_penitentiaire
  - p1_m0_seance
  - p1_ald_validee
  - p1_critere_ambulance
  - p2_exception_restant_assurance_maladie

p2_non_eligible_motif_absent:
  titre: Aucun motif ouvrant droit
  toutes ces conditions:
  - p2_parcours_apres_convocation
  - p2_prestation_prise_en_charge_validee
  - p2_motif_ouvrant_droit = non

p2_non_eligible_assurance_maladie:
  titre: Situation non éligible dans le parcours
  une de ces conditions:
  - p2_detenu_hors_parcours_standard
  - p2_non_eligible_motif_absent

p2_transport_urgence:
  titre: Contexte d’urgence hors transport par une équipe SMUR (Structure Mobile d’Urgence et de Réanimation)
  question: En dehors d’un transport par une équipe SMUR (Structure Mobile d’Urgence et de Réanimation), la prescription est-elle établie dans un contexte d’urgence ?
  une possibilité:
  - '''Appel au SAMU (Service d’Aide Médicale Urgente) - Centre 15'''
  - '''Autre situation d’urgence attestée par le prescripteur'''
  - '''Non'''
  applicable si:
    toutes ces conditions:
    - p2_parcours_apres_convocation
    - p2_prestation_prise_en_charge_validee
    - p2_motif_ouvrant_droit
    - p2_exception_aide_medicale_urgente = non
  spec_id: A4.5

p2_transport_urgence_repondu:
  titre: Contexte d’urgence renseigné
  une de ces conditions:
  - p2_exception_aide_medicale_urgente
  - p2_transport_urgence = 'Appel au SAMU (Service d’Aide Médicale Urgente) - Centre 15'
  - p2_transport_urgence = 'Autre situation d’urgence attestée par le prescripteur'
  - p2_transport_urgence = 'Non'

p2_accord_prealable_applicable:
  titre: Qualification de l’accord préalable applicable
  toutes ces conditions:
  - p2_parcours_apres_convocation
  - p2_prestation_prise_en_charge_validee
  - p2_motif_ouvrant_droit
  - p2_transport_urgence_repondu

p2_distance_aller_superieure_150km:
  titre: Distance aller supérieure à 150 kilomètres
  question: Le trajet aller est-il supérieur à 150 km ?
  applicable si: p2_accord_prealable_applicable
  spec_id: A3.1

p2_distance_aller_repondue:
  titre: Distance aller renseignée
  une de ces conditions:
  - p2_distance_aller_superieure_150km
  - p2_distance_aller_superieure_150km = non

p2_nombre_transports_prevus:
  titre: Nombre de transports prévus sur deux mois
  question: Combien de transports sont prévus au cours des 2 prochains mois pour ce même traitement ?
  type: nombre
  saisie:
    minimum: 1
    pas: 1
    entier: true
    valeur_par_defaut: null
  applicable si:
    toutes ces conditions:
    - p2_accord_prealable_applicable
    - p2_distance_aller_repondue
  spec_id: A3.2

p2_nombre_transports_prevus_valide:
  titre: Nombre de transports valide
  valeur: p2_nombre_transports_prevus >= 1

p2_chaque_trajet_aller_superieur_50km:
  titre: Distance de chaque transport d’une série potentielle
  question: Chaque trajet aller est-il supérieur à 50 km ?
  applicable si:
    toutes ces conditions:
    - p2_accord_prealable_applicable
    - p2_distance_aller_superieure_150km = non
    - p2_nombre_transports_prevus >= 4
  spec_id: A3.3

p2_distance_serie_repondue:
  titre: Distance de chaque transport renseignée
  une de ces conditions:
  - p2_chaque_trajet_aller_superieur_50km
  - p2_chaque_trajet_aller_superieur_50km = non

p2_transport_en_serie:
  titre: Transport en série
  toutes ces conditions:
  - p2_nombre_transports_prevus >= 4
  - p2_chaque_trajet_aller_superieur_50km

p2_transport_serie_declenche_dap:
  titre: Transport en série déclenchant une DAP (Demande d’Accord Préalable)
  toutes ces conditions:
  - p2_transport_en_serie
  - p1_ald_validee = non

p2_situations_accord_prealable_applicables:
  titre: Situations particulières relatives à l’accord préalable applicables
  toutes ces conditions:
  - p2_accord_prealable_applicable
  - p2_nombre_transports_prevus_valide
  - p2_distance_aller_superieure_150km = non
  - p2_transport_serie_declenche_dap = non
  - p2_exception_avion_bateau = non
  - une de ces conditions:
    - p2_nombre_transports_prevus < 4
    - p2_distance_serie_repondue

p2_special_avion_bateau:
  question: Transport par avion ou par bateau de ligne régulière.
  applicable si: p2_situations_accord_prealable_applicables
  spec_id: A3.4

p2_special_camsp_cmpp:
  question: Soins ou traitements dans un CAMSP (Centre d’Action Médico-Sociale Précoce) ou un CMPP (Centre Médico-Psycho-Pédagogique).
  applicable si: p2_situations_accord_prealable_applicables
  spec_id: A3.4

p2_special_engagement_maternite:
  question: Transport vers une maternité éloignée dans le cadre du dispositif Engagement maternité.
  applicable si: p2_situations_accord_prealable_applicables
  spec_id: A3.4

p2_special_samsah:
  question: Soins ou traitements dans un SAMSAH (Service d’Accompagnement Médico-Social pour Adultes Handicapés).
  applicable si: p2_situations_accord_prealable_applicables
  spec_id: A3.4

p2_special_aucune:
  question: Aucune de ces situations ne concerne le transport.
  applicable si: p2_situations_accord_prealable_applicables
  spec_id: A3.4

p2_situations_accord_prealable:
  titre: Situations particulières pouvant nécessiter un accord préalable
  question: Le transport concerne-t-il une ou plusieurs des situations suivantes ?
  description: Sélectionnez toutes les réponses correspondant à la situation du patient.
  mosaique:
    type: selection
    options:
    - p2_special_avion_bateau
    - p2_special_camsp_cmpp
    - p2_special_engagement_maternite
    - p2_special_samsah
    option aucun: p2_special_aucune
  applicable si: p2_situations_accord_prealable_applicables
  spec_id: A3.4

p2_situations_accord_prealable_repondues:
  titre: Situations particulières renseignées
  une de ces conditions:
  - p2_special_avion_bateau
  - p2_special_camsp_cmpp
  - p2_special_engagement_maternite
  - p2_special_samsah
  - p2_special_aucune
  applicable si: p2_situations_accord_prealable_applicables

p2_situation_speciale_declenche_dap:
  titre: Situation particulière déclenchant une DAP (Demande d’Accord Préalable)
  une de ces conditions:
  - p2_exception_avion_bateau
  - p2_special_avion_bateau
  - p2_special_camsp_cmpp
  - p2_special_engagement_maternite
  - p2_special_samsah

p2_accompagnement_tiers:
  titre: Accompagnement nécessitant l’assistance d’un tiers
  question: Le transport concerne-t-il l’accompagnement d’une personne nécessitant l’assistance d’un tiers ?
  applicable si:
    toutes ces conditions:
    - p2_situations_accord_prealable_repondues
    - p2_situation_speciale_declenche_dap = non
  spec_id: A3.8

p2_accompagnement_tiers_repondu:
  titre: Accompagnement par un tiers renseigné
  une de ces conditions:
  - p2_accompagnement_tiers
  - p2_accompagnement_tiers = non

p2_accord_prealable_requis:
  titre: Accord préalable requis
  une de ces conditions:
  - p2_distance_aller_superieure_150km
  - p2_transport_serie_declenche_dap
  - p2_situation_speciale_declenche_dap
  - p2_accompagnement_tiers

p2_accord_prealable_questionnaire_complete:
  titre: Questionnaire relatif à l’accord préalable complété
  une de ces conditions:
  - toutes ces conditions:
    - p2_distance_aller_superieure_150km
    - p2_nombre_transports_prevus_valide
  - toutes ces conditions:
    - p2_exception_avion_bateau
    - p2_nombre_transports_prevus_valide
  - toutes ces conditions:
    - p2_transport_serie_declenche_dap
    - p2_nombre_transports_prevus_valide
    - p2_distance_serie_repondue
  - toutes ces conditions:
    - p2_situations_accord_prealable_repondues
    - p2_situation_speciale_declenche_dap
  - toutes ces conditions:
    - p2_accompagnement_tiers_repondu

p2_document_dap_determine:
  titre: DAP (Demande d’Accord Préalable) déterminée
  toutes ces conditions:
  - p2_accord_prealable_applicable
  - p2_accord_prealable_questionnaire_complete
  - p2_accord_prealable_requis

p2_document_pmt_determine:
  titre: PMT (Prescription Médicale de Transport) déterminée
  toutes ces conditions:
  - p2_accord_prealable_applicable
  - p2_accord_prealable_questionnaire_complete
  - p2_accord_prealable_requis = non

p2_document_pmt_ou_dap_determine:
  titre: Document de prescription déterminé
  une de ces conditions:
  - p2_document_dap_determine
  - p2_document_pmt_determine

p2_trajet_aller_retour:
  titre: Sens du déplacement
  question: Quel est le sens du déplacement concerné par cette évaluation ?
  une possibilité:
  - '''aller simple'''
  - '''aller-retour identique'''
  - '''aller-retour différent'''
  applicable si: p2_document_pmt_ou_dap_determine
  spec_id: A4.1

p2_trajet_aller_retour_repondu:
  titre: Sens du déplacement renseigné
  une de ces conditions:
  - p2_trajet_aller_retour = 'aller simple'
  - p2_trajet_aller_retour = 'aller-retour identique'
  - p2_trajet_aller_retour = 'aller-retour différent'

p2_trajet_depart:
  titre: Lieu de départ
  question: Quel est le lieu de départ du trajet concerné ?
  une possibilité:
  - '''Domicile'''
  - '''Structure de soins'''
  - '''Autre lieu'''
  applicable si: p2_trajet_aller_retour_repondu
  spec_id: A4.2

p2_trajet_depart_repondu:
  titre: Lieu de départ renseigné
  une de ces conditions:
  - p2_trajet_depart = 'Domicile'
  - p2_trajet_depart = 'Structure de soins'
  - p2_trajet_depart = 'Autre lieu'

p2_trajet_arrivee:
  titre: Lieu d’arrivée
  question: Quel est le lieu d’arrivée du trajet concerné ?
  description: Le lieu d’arrivée doit être différent du lieu de départ. Pour un aller-retour, renseignez les lieux du trajet aller.
  une possibilité:
  - '''Un domicile différent du lieu de départ.'''
  - '''Une structure de soins différente du lieu de départ.'''
  - '''Un autre lieu différent du lieu de départ.'''
  applicable si: p2_trajet_depart_repondu
  spec_id: A4.3

p2_trajet_arrivee_repondu:
  titre: Lieu d’arrivée renseigné
  une de ces conditions:
  - p2_trajet_arrivee = 'Un domicile différent du lieu de départ.'
  - p2_trajet_arrivee = 'Une structure de soins différente du lieu de départ.'
  - p2_trajet_arrivee = 'Un autre lieu différent du lieu de départ.'

p2_depart_nom_lieu:
  titre: Nom de la structure ou du lieu de départ
  question: Quel est le nom de la structure ou du lieu de départ ?
  type: texte
  applicable si:
    toutes ces conditions:
    - p2_trajet_depart_repondu
    - p2_trajet_depart != 'Domicile'
  spec_id: D1

p2_depart_adresse:
  titre: Adresse du lieu de départ
  question: Quelle est l’adresse du lieu de départ ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D2

p2_depart_complement_adresse:
  titre: Complément d’adresse du lieu de départ
  question: Quel est le complément d’adresse du lieu de départ ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D3

p2_depart_code_postal:
  titre: Code postal du lieu de départ
  question: Quel est le code postal du lieu de départ ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D4

p2_depart_commune:
  titre: Commune du lieu de départ
  question: Quelle est la commune du lieu de départ ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D5

p2_depart_pays:
  titre: Pays du lieu de départ
  question: Quel est le pays du lieu de départ si celui-ci se situe hors de France ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D6

p2_arrivee_nom_lieu:
  titre: Nom de la structure ou du lieu d’arrivée
  question: Quel est le nom de la structure ou du lieu d’arrivée ?
  type: texte
  applicable si:
    toutes ces conditions:
    - p2_trajet_arrivee_repondu
    - p2_trajet_arrivee != 'Un domicile différent du lieu de départ.'
  spec_id: D7

p2_arrivee_adresse:
  titre: Adresse du lieu d’arrivée
  question: Quelle est l’adresse du lieu d’arrivée ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D8

p2_arrivee_complement_adresse:
  titre: Complément d’adresse du lieu d’arrivée
  question: Quel est le complément d’adresse du lieu d’arrivée ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D9

p2_arrivee_code_postal:
  titre: Code postal du lieu d’arrivée
  question: Quel est le code postal du lieu d’arrivée ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D10

p2_arrivee_commune:
  titre: Commune du lieu d’arrivée
  question: Quelle est la commune du lieu d’arrivée ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D11

p2_arrivee_pays:
  titre: Pays du lieu d’arrivée
  question: Quel est le pays du lieu d’arrivée si celui-ci se situe hors de France ?
  type: texte
  applicable si: p2_trajet_arrivee_repondu
  spec_id: D12

p2_depart_nom_requis:
  titre: Nom du lieu de départ requis
  une de ces conditions:
  - p2_trajet_depart = 'Structure de soins'
  - p2_trajet_depart = 'Autre lieu'

p2_arrivee_nom_requis:
  titre: Nom du lieu d’arrivée requis
  une de ces conditions:
  - p2_trajet_arrivee = 'Une structure de soins différente du lieu de départ.'
  - p2_trajet_arrivee = 'Un autre lieu différent du lieu de départ.'

p2_depart_nom_lieu_renseigne:
  titre: Nom de la structure ou du lieu de départ renseigné
  toutes ces conditions:
  - est défini: p2_depart_nom_lieu
  - p2_depart_nom_lieu != ''

p2_depart_adresse_renseignee:
  titre: Adresse du lieu de départ renseignée
  toutes ces conditions:
  - est défini: p2_depart_adresse
  - p2_depart_adresse != ''

p2_depart_code_postal_renseigne:
  titre: Code postal du lieu de départ renseigné
  toutes ces conditions:
  - est défini: p2_depart_code_postal
  - p2_depart_code_postal != ''

p2_depart_commune_renseignee:
  titre: Commune du lieu de départ renseignée
  toutes ces conditions:
  - est défini: p2_depart_commune
  - p2_depart_commune != ''

p2_arrivee_nom_lieu_renseigne:
  titre: Nom de la structure ou du lieu d’arrivée renseigné
  toutes ces conditions:
  - est défini: p2_arrivee_nom_lieu
  - p2_arrivee_nom_lieu != ''

p2_arrivee_adresse_renseignee:
  titre: Adresse du lieu d’arrivée renseignée
  toutes ces conditions:
  - est défini: p2_arrivee_adresse
  - p2_arrivee_adresse != ''

p2_arrivee_code_postal_renseigne:
  titre: Code postal du lieu d’arrivée renseigné
  toutes ces conditions:
  - est défini: p2_arrivee_code_postal
  - p2_arrivee_code_postal != ''

p2_arrivee_commune_renseignee:
  titre: Commune du lieu d’arrivée renseignée
  toutes ces conditions:
  - est défini: p2_arrivee_commune
  - p2_arrivee_commune != ''

p2_depart_nom_complete:
  titre: Nom du lieu de départ complété lorsqu’il est requis
  valeur:
    variations:
    - si: p2_depart_nom_requis
      alors: p2_depart_nom_lieu_renseigne
    - sinon: oui

p2_arrivee_nom_complete:
  titre: Nom du lieu d’arrivée complété lorsqu’il est requis
  valeur:
    variations:
    - si: p2_arrivee_nom_requis
      alors: p2_arrivee_nom_lieu_renseigne
    - sinon: oui

p2_adresses_obligatoires_completes:
  titre: Adresses obligatoires complétées
  toutes ces conditions:
  - p2_depart_nom_complete
  - p2_depart_adresse_renseignee
  - p2_depart_code_postal_renseigne
  - p2_depart_commune_renseignee
  - p2_arrivee_nom_complete
  - p2_arrivee_adresse_renseignee
  - p2_arrivee_code_postal_renseigne
  - p2_arrivee_commune_renseignee

p2_accident_cause_par_tiers:
  titre: Accident causé par un tiers
  question: Le transport est-il en rapport avec un accident causé par un tiers ?
  applicable si: p2_adresses_obligatoires_completes
  spec_id: A4.6

p2_accident_cause_par_tiers_repondu:
  titre: Réponse sur l’accident causé par un tiers renseignée
  une de ces conditions:
  - p2_accident_cause_par_tiers
  - p2_accident_cause_par_tiers = non

p2_lie_at_mp:
  titre: Lien avec un AT (Accident du Travail) ou une MP (Maladie Professionnelle)
  valeur: p2_contexte_at_mp
  spec_id: A4.7

p2_informations_document_completes:
  titre: Informations nécessaires au document complètes
  toutes ces conditions:
  - p2_document_pmt_ou_dap_determine
  - p2_trajet_aller_retour_repondu
  - p2_trajet_depart_repondu
  - p2_trajet_arrivee_repondu
  - p2_adresses_obligatoires_completes
  - p2_accident_cause_par_tiers_repondu
