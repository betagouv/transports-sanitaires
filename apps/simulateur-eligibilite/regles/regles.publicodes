  titre: p2_lieu_depart_type_effectif
  valeur:
    variations:
    - si: p2_type_depart_deduit
      alors: '''Structure de soins'''
    - sinon: p2_trajet_depart
  applicable si: p2_configuration_trajet_complete
p2_depart_nom_lieu:
  titre: Nom du lieu
  question: Nom du lieu
  applicable si: &id004
    est défini: p2_lieu_depart_type_effectif
  type: texte
p2_depart_adresse:
  titre: Numéro et libellé de la voie
  question: Numéro et libellé de la voie
  applicable si: *id004
  type: texte
p2_depart_complement_adresse:
  titre: Complément d’adresse (optionnel)
  question: Complément d’adresse (optionnel)
  applicable si: *id004
  type: texte
p2_depart_code_postal:
  titre: Code postal
  question: Code postal
  applicable si: *id004
  type: texte
p2_depart_commune:
  titre: Ville
  question: Ville
  applicable si: *id004
  type: texte
p2_depart_pays:
  titre: Pays - à renseigner uniquement si le lieu se situe hors de France
  question: Pays - à renseigner uniquement si le lieu se situe hors de France
  applicable si: *id004
  type: texte
p2_depart_pays_renseigne:
  titre: p2_depart_pays_renseigne
  toutes ces conditions:
  - est applicable: p2_depart_pays
  - est défini: p2_depart_pays
  - p2_depart_pays != ''
p2_depart_code_postal_renseigne:
  titre: p2_depart_code_postal_renseigne
  toutes ces conditions:
  - est applicable: p2_depart_code_postal
  - est défini: p2_depart_code_postal
  - p2_depart_code_postal != ''
