  - est défini: p2_arrivee_pays
  - p2_arrivee_pays != ''
p2_arrivee_code_postal_renseigne:
  titre: p2_arrivee_code_postal_renseigne
  toutes ces conditions:
  - est applicable: p2_arrivee_code_postal
  - est défini: p2_arrivee_code_postal
  - p2_arrivee_code_postal != ''
p2_arrivee_code_postal_complete:
  titre: p2_arrivee_code_postal_complete
  une de ces conditions:
  - p2_arrivee_code_postal_renseigne
  - p2_arrivee_pays_renseigne
p2_arrivee_format_valide:
  titre: p2_arrivee_format_valide
  description: Donnée technique calculée par le module de référence ; jamais une question.
p2_adresse_arrivee_obligatoire_complete:
  titre: p2_adresse_arrivee_obligatoire_complete
  toutes ces conditions:
  - *id005
  - toutes ces conditions:
    - est applicable: p2_arrivee_adresse
    - est défini: p2_arrivee_adresse
    - p2_arrivee_adresse != ''
  - toutes ces conditions:
    - est applicable: p2_arrivee_commune
    - est défini: p2_arrivee_commune
    - p2_arrivee_commune != ''
  - p2_arrivee_code_postal_complete
  - une de ces conditions:
    - p2_lieu_arrivee_type_effectif = 'Domicile'
    - toutes ces conditions:
      - est applicable: p2_arrivee_nom_lieu
