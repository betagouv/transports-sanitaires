  valeur:
    variations:
    - si:
        toutes ces conditions:
        - p2_permission_speciale
        - p2_document_dap_determine
      alors: p2_nombre_transports_permission_dap
    - si: p2_permission_speciale
      alors:
        variations:
        - si: cible_case_aller_retour
          alors: p2_permission_ar_par_mois * 2
        - sinon: p2_permission_ar_par_mois
    - si: p2_organisation_transports = 'aller-retour différent'
      alors: p2_nombre_transports_couvert_simulation
    - sinon: p2_nombre_transports_prevus
