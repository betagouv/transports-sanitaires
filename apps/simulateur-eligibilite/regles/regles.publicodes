  titre: p2_depart_code_postal_complete
  une de ces conditions:
  - p2_depart_code_postal_renseigne
  - p2_depart_pays_renseigne
p2_depart_format_valide:
  titre: p2_depart_format_valide
  description: Donnée technique calculée par le module de référence ; jamais une question.
p2_adresse_depart_obligatoire_complete:
  titre: p2_adresse_depart_obligatoire_complete
  toutes ces conditions:
  - *id004
  - toutes ces conditions:
    - est applicable: p2_depart_adresse
    - est défini: p2_depart_adresse
    - p2_depart_adresse != ''
  - toutes ces conditions:
    - est applicable: p2_depart_commune
    - est défini: p2_depart_commune
    - p2_depart_commune != ''
  - p2_depart_code_postal_complete
  - une de ces conditions:
    - p2_lieu_depart_type_effectif = 'Domicile'
    - toutes ces conditions:
      - est applicable: p2_depart_nom_lieu
      - est défini: p2_depart_nom_lieu
      - p2_depart_nom_lieu != ''
  - p2_depart_format_valide
p2_trajet_arrivee:
  titre: Quel est le type de lieu d’arrivée ?
  question: Quel est le type de lieu d’arrivée ?
  applicable si:
    toutes ces conditions:
    - p2_adresse_depart_obligatoire_complete
    - p2_type_arrivee_deduit = non
  une possibilité:
  - '''Domicile'''
  - '''EHPAD'''
  - '''USLD'''
  - '''Structure de soins'''
  - '''Autre lieu'''
  - '''Établissement pénitentiaire'''
p2_lieu_arrivee_type_effectif:
  titre: p2_lieu_arrivee_type_effectif
  valeur:
    variations:
    - si: p2_exception_admission_had
      alors: '''Domicile'''
    - si: p2_contexte_retour_penitentiaire
      alors: '''Établissement pénitentiaire'''
    - sinon: p2_trajet_arrivee
  applicable si: p2_adresse_depart_obligatoire_complete
p2_arrivee_nom_lieu:
  titre: Nom du lieu
  question: Nom du lieu
  applicable si: &id005
    est défini: p2_lieu_arrivee_type_effectif
  type: texte
p2_arrivee_adresse:
  titre: Numéro et libellé de la voie
  question: Numéro et libellé de la voie
  applicable si: *id005
  type: texte
p2_arrivee_complement_adresse:
  titre: Complément d’adresse (optionnel)
  question: Complément d’adresse (optionnel)
  applicable si: *id005
  type: texte
p2_arrivee_code_postal:
  titre: Code postal
  question: Code postal
  applicable si: *id005
  type: texte
p2_arrivee_commune:
  titre: Ville
  question: Ville
