  titre: Nom de l’hébergement temporaire non médicalisé
  question: Nom de l’hébergement temporaire non médicalisé
  applicable si: p2_htnm_lieu = 'Adresse distincte'
  type: texte
p2_htnm_adresse:
  titre: Adresse de l’hébergement temporaire non médicalisé
  question: Adresse de l’hébergement temporaire non médicalisé
  applicable si: p2_htnm_lieu = 'Adresse distincte'
  type: texte
p2_maternite_complete:
  titre: p2_maternite_complete
  une de ces conditions:
  - p2_contexte_engagement_maternite = non
  - toutes ces conditions:
    - est défini: p2_maternite_lieu
    - est défini: p2_maternite_niveau
    - est défini: p2_htnm_lieu
    - une de ces conditions:
      - p2_maternite_lieu != 'Adresse distincte'
      - toutes ces conditions:
        - toutes ces conditions:
          - est applicable: p2_maternite_nom
          - est défini: p2_maternite_nom
          - p2_maternite_nom != ''
        - toutes ces conditions:
          - est applicable: p2_maternite_adresse
          - est défini: p2_maternite_adresse
          - p2_maternite_adresse != ''
    - une de ces conditions:
      - p2_htnm_lieu != 'Adresse distincte'
      - toutes ces conditions:
        - toutes ces conditions:
          - est applicable: p2_htnm_nom
          - est défini: p2_htnm_nom
          - p2_htnm_nom != ''
        - toutes ces conditions:
          - est applicable: p2_htnm_adresse
          - est défini: p2_htnm_adresse
          - p2_htnm_adresse != ''
