  - p2_tranche_distance_trajet_aller = 'Plus de 50 km et jusqu’à 150 km inclus'
  - p2_tranche_distance_trajet_aller = 'Plus de 150 km'
p2_justification_longue_distance:
  titre: Pourquoi les soins nécessitent-ils un déplacement à plus de 150 km ?
  question: Pourquoi les soins nécessitent-ils un déplacement à plus de 150 km ?
  applicable si:
    toutes ces conditions:
    - p2_adresses_obligatoires_completes
    - p2_distance_aller_superieure_150km
  type: texte
p2_qualification_trajet_complete:
  titre: p2_qualification_trajet_complete
  toutes ces conditions:
  - p2_adresses_obligatoires_completes
  - une de ces conditions:
    - toutes ces conditions:
      - p2_convocation
      - p2_convocation_caracteristiques_complet
    - toutes ces conditions:
      - p2_convocation = non
      - est défini: p2_tranche_distance_trajet_aller
  - une de ces conditions:
    - p2_distance_aller_superieure_150km = non
    - toutes ces conditions:
      - est applicable: p2_justification_longue_distance
      - est défini: p2_justification_longue_distance
      - p2_justification_longue_distance != ''
p2_transport_en_serie:
  titre: p2_transport_en_serie
  toutes ces conditions:
  - p2_permission_speciale = non
  - p2_convocation = non
  - p2_nombre_transports_prevus >= 4
  - p2_distance_aller_superieure_50km
p2_ald_ouvrant_droit:
  titre: p2_ald_ouvrant_droit
  toutes ces conditions:
  - p1_ald_validee
  - une de ces conditions:
    - p0_date_reference_yyyymmdd < 20261001
    - p1_type_ald = 'Exonérante'
p2_motif_ouvrant_droit:
  titre: p2_motif_ouvrant_droit
  une de ces conditions:
  - p2_convocation_dap_applicable
  - p2_contexte_hospitalisation
  - p2_contexte_at_mp
  - p2_contexte_retour_penitentiaire
  - p2_ald_ouvrant_droit
  - p1_critere_ambulance
  - p2_permission_speciale
  - p2_exception_restant_assurance_maladie
  - p2_distance_aller_superieure_150km
  - p2_transport_en_serie
  - p2_special_camsp_cmpp
  - p2_special_samsah
  - p2_contexte_engagement_maternite
p2_avion_bateau_effectif:
  titre: p2_avion_bateau_effectif
