p2_maternite_lieu:
  titre: Quelle adresse du trajet correspond à la maternité ?
  question: Quelle adresse du trajet correspond à la maternité ?
  applicable si:
    toutes ces conditions:
    - p2_document_dap_determine
    - p2_contexte_engagement_maternite
  une possibilité:
  - '''Départ'''
  - '''Arrivée'''
  - '''Adresse distincte'''
p2_maternite_nom:
  titre: Nom de la maternité
  question: Nom de la maternité
  applicable si: p2_maternite_lieu = 'Adresse distincte'
  type: texte
p2_maternite_adresse:
  titre: Adresse de la maternité
  question: Adresse de la maternité
  applicable si: p2_maternite_lieu = 'Adresse distincte'
  type: texte
