# Règles de décision Publicode. Les faits sont normalisés depuis Q0–Q2.
# L'application transmet oui/non seulement lorsque leur preuve est établie ;
# elle ne transmet jamais un positif de nomenclature sans preuve officielle.
fait_p1_complete:
  titre: Réponses médicales validées
fait_p2_complete:
  titre: Réponses administratives validées
fait_autonomie_professionnel:
  titre: Intervention d'un professionnel nécessaire
fait_critere_allonge:
  titre: Position allongée ou demi-assise
fait_critere_brancard:
  titre: Brancardage ou portage
fait_critere_surveillance:
  titre: Surveillance qualifiée constante
fait_critere_oxygene:
  titre: Oxygène pendant le transport
fait_critere_asepsie:
  titre: Asepsie rigoureuse
fait_critere_fauteuil:
  titre: Fauteuil sans transfert
fait_critere_tap:
  titre: Autre critère de transport assis professionnel
fait_partage_incompatible:
  titre: État incompatible avec le transport partagé
fait_bariatrique:
  titre: Forte corpulence de plus de 150 kg, seulement si un motif médical d'ambulance est établi
fait_accompagnant:
  titre: Présence nécessaire d'un proche accompagnant
fait_prefere_transport_commun:
  titre: Préférence transports en commun si mode non professionnel
fait_source_officielle_active:
  titre: Source de prestation officielle active
fait_correspondance_univoque:
  titre: Correspondance du libellé univoque
fait_conditions_soin_verifiees:
  titre: Toutes les conditions de la prestation vérifiées
fait_regime_verifie:
  titre: Régime applicable vérifié
fait_situation_soins_qualifiante:
  titre: Hospitalisation réelle ou séance assimilée qualifiée, avec régime applicable vérifié
fait_exclusion_soin_prouvee:
  titre: Exclusion du soin prouvée par une source, décisive seulement si la prestation conditionne ce transport
fait_exclusion_transport_prouvee:
  titre: Exclusion juridique applicable à ce transport, source et conditions vérifiées
fait_preuve_prescripteur_qualifiante:
  titre: Confirmation de couverture par le prescripteur accompagnée de son fondement vérifiable
fait_preuve_prestation_absente:
  titre: Après recherche, ni preuve automatique positive ni preuve du prescripteur
fait_prestation_non_couverte_declaree:
  titre: Le prescripteur déclare que la prestation n'est pas prise en charge
fait_evenement_sans_soin:
  titre: Fondement autonome sans soin associé
fait_hospitalisation:
  titre: Hospitalisation ou séance assimilée établie
fait_atmp_lie:
  titre: AT ou MP en lien direct
fait_ald_liee:
  titre: Soin en lien avec ALD et déficience
fait_ald_exonerante_3_ou_4:
  titre: ALD ouvrant droit au titre du 3° ou du 4° de L.160-14 vérifiée
fait_mineur_soins_prolonges_reconnus:
  titre: Mineur, soins continus de plus de six mois reconnus par le service médical, lien du déplacement et déficience vérifiés
fait_mineur_soins_prolonges_a_verifier:
  titre: Situation de soins prolongés du mineur explicitement signalée mais reconnaissance non vérifiable
fait_motif_camsp:
  titre: Soin CAMSP ou CMPP qualifié
fait_motif_samsah:
  titre: Soins SAMSAH qualifiés
fait_motif_pension:
  titre: Soins de pension militaire qualifiés
fait_distance_plus_50:
  titre: Le trajet actuellement évalué dépasse 50 km, la série étant qualifiée séparément
fait_distance_plus_150:
  titre: Trajet aller dépasse 150 km
fait_serie_qualifiante:
  titre: Au moins quatre transports de plus de 50 km chacun au titre du même traitement, dans les deux mois du premier
fait_avion_bateau_ligne:
  titre: Avion ou bateau de ligne régulière
fait_centre_reference_destination:
  titre: Le centre de référence est la destination réelle
fait_appel_centre15:
  titre: Appel effectif au SAMU-Centre 15
fait_dap_maternite:
  titre: Dispositif Engagement maternité qualifié avec DAP
fait_urgence_attestee:
  titre: Urgence attestée par le médecin prescripteur
fait_urgence_repondue:
  titre: Question d'urgence DAP répondue
fait_transfert_article80:
  titre: Transfert pendant hospitalisation relevant potentiellement de l'article 80
fait_exception_article80_admission_sans_sejour:
  titre: Admission dans le nouvel établissement sans prestation initiale
fait_exception_article80_air_mer:
  titre: Segment aérien ou maritime relevant de l'exception
fait_exception_article80_had_intercurrent:
  titre: HAD, prestation hors soins liés à la HAD
fait_exception_article80_usld:
  titre: USLD hors même implantation
fait_exception_article80_ehpad:
  titre: EHPAD hors même implantation
fait_exception_article80_radiotherapie:
  titre: Transfert provisoire pour radiothérapie en libéral ou centre de santé
fait_exception_article80_dialyse_domicile:
  titre: Patient pratiquant la dialyse à domicile
fait_exception_article80_admission_had:
  titre: Retour à domicile pour admission en HAD
fait_centre15_interetablissements:
  titre: Centre 15 hors SMUR entre établissements, sous-cas provisoire
fait_htnm_hors_maternite:
  titre: Segment HTNM hors Engagement maternité
fait_htnm_segment_verifie:
  titre: Règle exacte du segment HTNM vérifiée
fait_permission:
  titre: Permission temporaire
fait_permission_mineur_admissible:
  titre: Permission moins de 20 ans répondant à R.322-10-8
fait_permission_charge_patient:
  titre: Permission à charge du patient prouvée
fait_convocation:
  titre: Convocation ou appareillage relevant de R.322-10 2°
fait_trajet_etranger:
  titre: Le départ ou l'arrivée du trajet évalué est hors de France

cible_mode_ambulance:
  une de ces conditions:
    - fait_critere_allonge
    - fait_critere_brancard
    - fait_critere_surveillance
    - fait_critere_oxygene
    - fait_critere_asepsie
cible_ambulance_equipement_bariatrique:
  toutes ces conditions:
    - cible_mode_ambulance
    - fait_bariatrique
cible_mode_coherent:
  une de ces conditions:
    - fait_autonomie_professionnel = non
    - cible_mode_ambulance
    - fait_critere_fauteuil
    - fait_critere_tap
cible_mode_id:
  valeur:
    variations:
      - si: cible_mode_ambulance
        alors: "'AMBULANCE'"
      - si: fait_critere_fauteuil
        alors: "'TPMR'"
      - si:
          toutes ces conditions:
            - fait_autonomie_professionnel
            - une de ces conditions:
                - fait_critere_tap
                - fait_critere_fauteuil
        alors: "'TAP'"
      - si: fait_prefere_transport_commun
        alors: "'TRANSPORT_COMMUN'"
      - sinon: "'VEHICULE_PERSONNEL'"
  applicable si: fait_p1_complete
cible_care_status:
  valeur:
    variations:
      - si: fait_evenement_sans_soin
        alors: "'SANS_OBJET_SOIN'"
      - si: fait_exclusion_soin_prouvee
        alors: "'NON_COUVERTE_PROUVEE'"
      - si:
          toutes ces conditions:
            - fait_situation_soins_qualifiante
            - fait_regime_verifie
        alors: "'COUVERTE'"
      - si: fait_preuve_prescripteur_qualifiante
        alors: "'COUVERTE'"
      - si:
          toutes ces conditions:
            - fait_source_officielle_active
            - fait_correspondance_univoque
            - fait_conditions_soin_verifiees
            - fait_regime_verifie
        alors: "'COUVERTE'"
      - sinon: "'INDETERMINEE'"
# Les trois prédicats de droit ne sont jamais des entrées de l’interface.
# Le titre précis / remboursement d'un acte n'est une condition autonome
# d'aucun motif de transport actuellement qualifié par ce référentiel.
# L'identification d'un événement (hospitalisation, CAMSP, convocation...) reste requise.
cible_qualification_soin_decisive_transport:
  valeur: non
# Une ALD inconnue ne bloque ni l'ambulance autonome ni un autre fondement
# suffisant, sauf si elle seule pourrait dispenser de DAP une série.
cible_autre_motif_ald:
  une de ces conditions:
    - cible_mode_ambulance
    - fait_hospitalisation
    - fait_atmp_lie
    - cible_mineur_soins_prolonges
    - cible_serie
    - fait_distance_plus_150
    - fait_motif_camsp
    - fait_motif_samsah
    - fait_motif_pension
    - fait_dap_maternite
    - fait_convocation
    - fait_permission_mineur_admissible
# Le cas du mineur inconnu ne doit pas dépendre de sa propre preuve manquante.
cible_autre_motif_hors_mineur:
  une de ces conditions:
    - cible_mode_ambulance
    - fait_hospitalisation
    - fait_atmp_lie
    - cible_ald_qualifiante
    - cible_serie
    - fait_distance_plus_150
    - fait_motif_camsp
    - fait_motif_samsah
    - fait_motif_pension
    - fait_dap_maternite
    - fait_convocation
    - fait_permission_mineur_admissible
# Une réponse Q2.10.a/b impossible à vérifier laisse fait_convocation absent.
# L'absence ne vaut pas Non : la catégorie peut modifier le support du trajet.
# Si Q2.10 est sans objet et masquée, l'application prouve sa non-applicabilité
# et transmet fait_convocation = non, conformément au contrat de normalisation.
cible_convocation_inconnue_decisive:
  est non défini: fait_convocation
cible_preuve_ald_inconnue_decisive:
  une de ces conditions:
    - toutes ces conditions:
        - fait_ald_liee
        - est non défini: fait_ald_exonerante_3_ou_4
        - cible_autre_motif_ald = non
    - toutes ces conditions:
        - fait_ald_liee
        - est non défini: fait_ald_exonerante_3_ou_4
        - cible_serie
        - fait_distance_plus_150 = non
        - fait_avion_bateau_ligne = non
        - fait_motif_camsp = non
        - fait_dap_maternite = non
cible_reconnaissance_mineur_inconnue_decisive:
  toutes ces conditions:
    - une de ces conditions:
        - toutes ces conditions:
            - est défini: fait_mineur_soins_prolonges_a_verifier
            - fait_mineur_soins_prolonges_a_verifier
        # Compatibilité des anciennes traces : l'ancien aiguillage ALD demeure
        # lisible, sans être requis par la nouvelle entrée directe Q1.3.
        - toutes ces conditions:
            - fait_ald_liee
            - fait_ald_exonerante_3_ou_4 = non
    - est non défini: fait_mineur_soins_prolonges_reconnus
    - cible_autre_motif_hors_mineur = non
# Les inconnues restantes sont nommées par branche ; pas de drapeau
# générique inventé par l'interface. Une permission ou une exception
# article 80 encore inconnue après les questions requises relève de la caisse.
cible_couverture_inconnue_decisive:
  une de ces conditions:
    - toutes ces conditions:
        - fait_permission
        - est non défini: fait_permission_mineur_admissible
        - est non défini: fait_permission_charge_patient
    - toutes ces conditions:
        - fait_hospitalisation
        - est non défini: fait_transfert_article80
# L'issue finale reste conditionnée à fait_p2_complete.
cible_ald_qualifiante:
  toutes ces conditions:
    - fait_ald_liee
    - fait_ald_exonerante_3_ou_4
cible_mineur_soins_prolonges:
  valeur: fait_mineur_soins_prolonges_reconnus
cible_serie:
  toutes ces conditions:
    - fait_serie_qualifiante
    - fait_distance_plus_50
cible_exception_article80:
  une de ces conditions:
    - fait_exception_article80_admission_sans_sejour
    - fait_exception_article80_air_mer
    - fait_exception_article80_had_intercurrent
    - fait_exception_article80_usld
    - fait_exception_article80_ehpad
    - fait_exception_article80_radiotherapie
    - fait_exception_article80_dialyse_domicile
    - fait_exception_article80_admission_had
cible_motif_transport:
  une de ces conditions:
    - cible_mode_ambulance
    - fait_hospitalisation
    - fait_atmp_lie
    - cible_ald_qualifiante
    - cible_mineur_soins_prolonges
    - cible_serie
    - fait_distance_plus_150
    - fait_motif_camsp
    - fait_motif_samsah
    - fait_motif_pension
    - fait_dap_maternite
    - fait_convocation
    - fait_permission_mineur_admissible
cible_dap_motif_longue_distance:
  valeur: fait_distance_plus_150
cible_dap_motif_serie:
  toutes ces conditions:
    - cible_serie
    - cible_ald_qualifiante = non
cible_dap_motif_avion_bateau:
  valeur: fait_avion_bateau_ligne
cible_dap_motif_camsp_cmpp:
  valeur: fait_motif_camsp
cible_dap_motif_engagement_maternite:
  valeur: fait_dap_maternite
cible_dap_requise:
  une de ces conditions:
    - cible_dap_motif_longue_distance
    - cible_dap_motif_serie
    - cible_dap_motif_avion_bateau
    - cible_dap_motif_camsp_cmpp
    - cible_dap_motif_engagement_maternite
cible_dap_fondement_autonome:
  une de ces conditions:
    - cible_dap_motif_camsp_cmpp
    - cible_dap_motif_engagement_maternite
cible_point_cnam:
  une de ces conditions:
    - fait_centre15_interetablissements
    - fait_motif_samsah
    - fait_motif_pension
    - toutes ces conditions:
        - fait_htnm_hors_maternite
        - fait_htnm_segment_verifie = non
    - toutes ces conditions:
        - fait_dap_maternite
        - fait_urgence_attestee
    - toutes ces conditions:
        - cible_dap_motif_camsp_cmpp
        - fait_urgence_attestee
# Garde d’affichage de Q2.3.4 à sa place dans P2. Les faits des branches
# futures ne deviennent pas Non : seules leurs valeurs déjà définies peuvent
# établir une orientation prioritaire qui rend cette question sans objet.
cible_orientation_sans_urgence_deja_etablie:
  une de ces conditions:
    - toutes ces conditions:
        - est défini: fait_exclusion_transport_prouvee
        - fait_exclusion_transport_prouvee
    - toutes ces conditions:
        - est défini: fait_transfert_article80
        - fait_transfert_article80
        - est défini: cible_exception_article80
        - cible_exception_article80 = non
    - toutes ces conditions:
        - est défini: fait_permission_charge_patient
        - fait_permission_charge_patient
    - toutes ces conditions:
        - est défini: fait_centre15_interetablissements
        - fait_centre15_interetablissements
    - toutes ces conditions:
        - est défini: fait_motif_samsah
        - fait_motif_samsah
    - toutes ces conditions:
        - est défini: fait_motif_pension
        - fait_motif_pension
    - toutes ces conditions:
        - est défini: fait_htnm_hors_maternite
        - fait_htnm_hors_maternite
        - est défini: fait_htnm_segment_verifie
        - fait_htnm_segment_verifie = non
    - toutes ces conditions:
        - est défini: cible_qualification_soin_decisive_transport
        - cible_qualification_soin_decisive_transport
        - est défini: fait_evenement_sans_soin
        - fait_evenement_sans_soin = non
        - une de ces conditions:
            - toutes ces conditions:
                - est défini: cible_care_status
                - cible_care_status = 'NON_COUVERTE_PROUVEE'
            - toutes ces conditions:
                - est défini: fait_prestation_non_couverte_declaree
                - fait_prestation_non_couverte_declaree
            - toutes ces conditions:
                - est défini: fait_preuve_prestation_absente
                - fait_preuve_prestation_absente
    - toutes ces conditions:
        - est défini: fait_urgence_attestee
        - fait_urgence_attestee
        - une de ces conditions:
            - toutes ces conditions:
                - est défini: fait_motif_camsp
                - fait_motif_camsp
            - toutes ces conditions:
                - est défini: fait_dap_maternite
                - fait_dap_maternite
cible_question_urgence_a_afficher:
  toutes ces conditions:
    - cible_dap_requise
    - cible_mode_coherent
    - cible_orientation_sans_urgence_deja_etablie = non
# Contrôle final inchangé : cette cible n’est pas une garde d’affichage.
# Elle reste consommée par cible_decision_calculable, après qualification P2.
cible_question_urgence_requise:
  toutes ces conditions:
    - cible_dap_requise
    - cible_mode_coherent
    - cible_motif_transport
    - fait_exclusion_transport_prouvee = non
    - une de ces conditions:
        - cible_care_status != 'NON_COUVERTE_PROUVEE'
        - cible_qualification_soin_decisive_transport = non
    - une de ces conditions:
        - cible_qualification_soin_decisive_transport = non
        - toutes ces conditions:
            - fait_preuve_prestation_absente = non
            - fait_prestation_non_couverte_declaree = non
    - une de ces conditions:
        - cible_care_status != 'INDETERMINEE'
        - cible_qualification_soin_decisive_transport = non
        - fait_trajet_etranger
    - une de ces conditions:
        - fait_transfert_article80 = non
        - cible_exception_article80
    - fait_permission_charge_patient = non
    - fait_centre15_interetablissements = non
    - fait_motif_samsah = non
    - fait_motif_pension = non
    - cible_preuve_ald_inconnue_decisive = non
    - cible_reconnaissance_mineur_inconnue_decisive = non
    - cible_convocation_inconnue_decisive = non
    - cible_couverture_inconnue_decisive = non
    - une de ces conditions:
        - fait_htnm_hors_maternite = non
        - fait_htnm_segment_verifie
cible_decision_calculable:
  toutes ces conditions:
    - fait_p1_complete
    - fait_p2_complete
    - cible_mode_coherent
    - une de ces conditions:
        - cible_question_urgence_requise = non
        - fait_urgence_repondue
cible_issue_id:
  valeur:
    variations:
      - si: fait_exclusion_transport_prouvee
        alors: "'ISSUE_NON_ELIGIBLE'"
      - si:
          toutes ces conditions:
            - cible_care_status = 'NON_COUVERTE_PROUVEE'
            - cible_qualification_soin_decisive_transport
            - fait_evenement_sans_soin = non
        alors: "'ISSUE_NON_ELIGIBLE'"
      - si:
          toutes ces conditions:
            - fait_evenement_sans_soin = non
            - une de ces conditions:
                - toutes ces conditions:
                    - cible_qualification_soin_decisive_transport
                    - fait_prestation_non_couverte_declaree
                - toutes ces conditions:
                    - cible_qualification_soin_decisive_transport
                    - fait_preuve_prestation_absente
        alors: "'ISSUE_NON_ELIGIBLE'"
      - si:
          une de ces conditions:
            - cible_point_cnam
            - cible_preuve_ald_inconnue_decisive
            - cible_reconnaissance_mineur_inconnue_decisive
            - cible_convocation_inconnue_decisive
            - cible_couverture_inconnue_decisive
        alors: "'ISSUE_CAISSE'"
      - si:
          toutes ces conditions:
            - fait_transfert_article80
            - cible_exception_article80 = non
        alors: "'ISSUE_ETABLISSEMENT'"
      - si: fait_permission_charge_patient
        alors: "'ISSUE_PERMISSION_PATIENT'"
      - si:
          toutes ces conditions:
            - fait_permission
            - fait_permission_mineur_admissible
            - cible_dap_requise = non
        alors: "'ISSUE_S3141'"
      - si: cible_motif_transport = non
        alors: "'ISSUE_NON_ELIGIBLE'"
      - si: fait_trajet_etranger
        alors: "'ISSUE_DAP_ETRANGER_A_EXAMINER'"
      - si:
          toutes ces conditions:
            - cible_care_status = 'INDETERMINEE'
            - cible_qualification_soin_decisive_transport
        alors: "'ISSUE_CAISSE'"
      - si:
          toutes ces conditions:
            - cible_dap_requise
            - fait_urgence_attestee
        alors: "'ISSUE_DAP_URGENCE_ATTESTEE'"
      - si: cible_dap_requise
        alors: "'ISSUE_DAP_SANS_URGENCE'"
      - si: fait_convocation
        alors: "'ISSUE_CONVOCATION'"
      - sinon: "'ISSUE_PMT'"
  applicable si: cible_decision_calculable
cible_support_id:
  valeur:
    variations:
      - si: cible_issue_id = 'ISSUE_PMT'
        alors: "'S3138g'"
      - si:
          une de ces conditions:
            - cible_issue_id = 'ISSUE_DAP_SANS_URGENCE'
            - cible_issue_id = 'ISSUE_DAP_URGENCE_ATTESTEE'
            - cible_issue_id = 'ISSUE_DAP_ETRANGER_A_EXAMINER'
        alors: "'S3139h'"
      - si: cible_issue_id = 'ISSUE_S3141'
        alors: "'S3141'"
      - sinon: "'AUCUN'"
  applicable si: cible_decision_calculable
cible_financeur:
  valeur:
    variations:
      - si: cible_issue_id = 'ISSUE_ETABLISSEMENT'
        alors: "'ETABLISSEMENT'"
      - si: cible_issue_id = 'ISSUE_PERMISSION_PATIENT'
        alors: "'PATIENT'"
      - si:
          une de ces conditions:
            - cible_issue_id = 'ISSUE_CAISSE'
            - cible_issue_id = 'ISSUE_NON_ELIGIBLE'
            - cible_issue_id = 'ISSUE_DAP_ETRANGER_A_EXAMINER'
        alors: "'NON_CONCLU'"
      - sinon: "'ASSURANCE_MALADIE'"
  applicable si: cible_decision_calculable
cible_urgence_attestee:
  valeur: fait_urgence_attestee
  applicable si: cible_dap_requise
cible_reponse_explicite_caisse:
  valeur: fait_trajet_etranger
  applicable si: cible_issue_id = 'ISSUE_DAP_ETRANGER_A_EXAMINER'
cible_attente_accord:
  valeur:
    variations:
      - si:
          toutes ces conditions:
            - cible_dap_requise
            - fait_urgence_attestee = non
        alors: oui
      - si: cible_issue_id = 'ISSUE_DAP_ETRANGER_A_EXAMINER'
        alors: oui
      - si:
          toutes ces conditions:
            - cible_dap_requise
            - fait_urgence_attestee
            - cible_dap_fondement_autonome = non
        alors: non
      - sinon: non
  applicable si:
    une de ces conditions:
      - cible_issue_id = 'ISSUE_DAP_SANS_URGENCE'
      - cible_issue_id = 'ISSUE_DAP_URGENCE_ATTESTEE'
      - cible_issue_id = 'ISSUE_DAP_ETRANGER_A_EXAMINER'
cible_reason_code:
  valeur:
    variations:
      - si: fait_exclusion_transport_prouvee
        alors: "'TRANSPORT_EXCLU_PROUVE'"
      - si:
          toutes ces conditions:
            - cible_issue_id = 'ISSUE_NON_ELIGIBLE'
            - cible_care_status = 'NON_COUVERTE_PROUVEE'
            - cible_qualification_soin_decisive_transport
        alors: "'SOIN_NON_COUVERT_PROUVE'"
      - si:
          toutes ces conditions:
            - cible_issue_id = 'ISSUE_NON_ELIGIBLE'
            - fait_prestation_non_couverte_declaree
        alors: "'NON_COUVERTE_DECLAREE'"
      - si:
          toutes ces conditions:
            - cible_issue_id = 'ISSUE_NON_ELIGIBLE'
            - cible_qualification_soin_decisive_transport
            - fait_preuve_prestation_absente
        alors: "'PREUVE_PRESTATION_ABSENTE'"
      - si: cible_issue_id = 'ISSUE_DAP_ETRANGER_A_EXAMINER'
        alors: "'TRANSPORT_ETRANGER_EXAMEN_CAISSE'"
      - si: cible_preuve_ald_inconnue_decisive
        alors: "'ALD_BASE_NON_VERIFIABLE'"
      - si: cible_reconnaissance_mineur_inconnue_decisive
        alors: "'MINEUR_RECONNAISSANCE_NON_VERIFIABLE'"
      - si: cible_convocation_inconnue_decisive
        alors: "'CONVOCATION_CONDITION_NON_VERIFIABLE'"
      - si: cible_couverture_inconnue_decisive
        alors: "'AUTRE_DROIT_NON_VERIFIABLE'"
      - si: fait_motif_samsah
        alors: "'SAMSAH_DAP_SUPPORT_A_QUALIFIER'"
      - si: fait_motif_pension
        alors: "'PENSION_MILITAIRE_ACCORD_CIRCUIT_A_QUALIFIER'"
      - si: fait_centre15_interetablissements
        alors: "'CNAM_CENTRE15_INTERETABLISSEMENT'"
      - si: fait_htnm_hors_maternite
        alors: "'CNAM_HTNM_HORS_MATERNITE'"
      - si:
          toutes ces conditions:
            - cible_dap_motif_camsp_cmpp
            - fait_urgence_attestee
        alors: "'DAP_AUTONOME_URGENCE_NON_VERIFIEE'"
      - si:
          toutes ces conditions:
            - fait_dap_maternite
            - fait_urgence_attestee
        alors: "'CNAM_ENGAGEMENT_MATERNITE_URGENCE'"
      - si:
          toutes ces conditions:
            - cible_care_status = 'INDETERMINEE'
            - cible_qualification_soin_decisive_transport
        alors: "'SOINS_NON_VERIFIABLES'"
      - si:
          toutes ces conditions:
            - cible_issue_id = 'ISSUE_NON_ELIGIBLE'
            - cible_motif_transport = non
        alors: "'AUCUN_MOTIF_TRANSPORT'"
      - si: cible_issue_id = 'ISSUE_ETABLISSEMENT'
        alors: "'ARTICLE80_ETABLISSEMENT'"
      - si: cible_issue_id = 'ISSUE_S3141'
        alors: "'PERMISSION_MINEUR'"
      - sinon: "'MOTIF_QUALIFIE'"
  applicable si: cible_decision_calculable

# Projections documentaires depuis les mêmes faits, jamais depuis Q3.
cible_mode_tap_ou_tpmr:
  une de ces conditions:
    - cible_mode_id = 'TAP'
    - cible_mode_id = 'TPMR'
cible_mode_individual:
  valeur: cible_mode_id = 'VEHICULE_PERSONNEL'
cible_mode_public:
  valeur: cible_mode_id = 'TRANSPORT_COMMUN'
cible_ambulance_position_allongee_demi_assise:
  valeur: fait_critere_allonge
cible_ambulance_brancardage_portage:
  valeur: fait_critere_brancard
cible_ambulance_surveillance_constante:
  valeur: fait_critere_surveillance
cible_ambulance_oxygene:
  valeur: fait_critere_oxygene
cible_ambulance_isolement_asepsie:
  valeur: fait_critere_asepsie
cible_fauteuil_roulant:
  valeur: fait_critere_fauteuil
cible_transport_partage_incompatible:
  valeur: fait_partage_incompatible
cible_personne_accompagnante:
  valeur: fait_accompagnant
cible_ald_juridiquement_qualifiante_3_ou_4_degres:
  toutes ces conditions:
    - fait_ald_liee
    - fait_ald_exonerante_3_ou_4
cible_mineur_ald_non_exonerante_reconnue:
  toutes ces conditions:
    - fait_mineur_soins_prolonges_reconnus
    # Une ALD à 100 % positivement établie conserve sa case propre.
    # Le dispositif mineur est indépendant d'une déclaration générique d'ALD.
    - une de ces conditions:
        - est non défini: cible_ald_qualifiante
        - cible_ald_qualifiante = non
cible_hospitalisation_ou_seances_assimilees:
  valeur: fait_hospitalisation
cible_situation_at_mp:
  valeur: fait_atmp_lie
cible_situation_pension_militaire:
  valeur: fait_motif_pension
cible_centre_reference_destination_reelle:
  valeur: fait_centre_reference_destination
cible_urgence_appel15:
  valeur: fait_appel_centre15
cible_urgence_autre:
  toutes ces conditions:
    - fait_urgence_attestee
    - fait_appel_centre15 = non
