{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Chaque étape du pipeline est lançable seule (`npm run extract`, `staging`,
  // …) : ce sont autant de points d'entrée. knip les déduit des scripts npm,
  // restent les tests.
  "entry": ["tests/**/*.test.ts"],
  "project": ["src/**/*.ts"]
}
