{
  "name": "glossaire-notion",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "prezip": "pnpm build",
    "zip": "rm -f glossaire-notion-*.zip && cd dist && zip -r ../glossaire-notion-$npm_package_version.zip . && cd ..",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc -b",
    "verifier": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build",
    "knip": "knip --directory ../.. --workspace apps/glossaire-notion"
  },
  "dependencies": {
    "notion-client": "^7.10.0",
    "notion-types": "^7.10.0",
    "notion-utils": "^7.10.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
